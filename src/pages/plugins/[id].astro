---
// One page per package in the official repository, built from its
// manifest.json (and README.md, when it has one).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Aside } from '@astrojs/starlight/components';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import { loadPackages, RAW, TREE } from '../../lib/plugin-repo.mjs';

export async function getStaticPaths() {
  const packages = await loadPackages();
  return packages.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { manifest, path } = entry;
const plugin = manifest.plugin ?? {};
const isPlugin = manifest.type === 'plugin';
const barViews = (entry.views ?? []).filter((view) => view.startsWith('Bar'));
const hasSettings = (entry.views ?? []).includes('Settings');
const parts = [
  plugin.facet && ['Facet views', `${plugin.facet}: drawn by the shell, confined to what it hands them`],
  plugin.exec && ['A process', `${plugin.exec[0]}: its logic, talking to the shell over JSON lines`],
  plugin.native && ['C++', `${plugin.native}: built by CI from its source, runs inside the shell`],
].filter(Boolean);
const permissions = plugin.permissions ?? [];
const compositors = manifest.compositors ?? [];
const authors = (manifest.authors ?? []).map((author) => (typeof author === 'string' ? { name: author } : author));
const previews = manifest.previews ?? [];

// What each permission lets a plugin do, in the words users need.
const meaning = {
  shell: 'Runs blxshell commands: opens panels, the launcher or the dashboard, locks the screen. Enforced by blxshell.',
  notifications: 'Shows desktop notifications. Enforced by blxshell.',
  network: 'Talks to the network.',
  filesystem: 'Reads or writes files outside its own folder.',
  spawn: 'Starts other programs.',
  native: 'Includes C++ that runs inside the shell. Built by CI from the source in this repository.',
};

const shown = (value) => (value === undefined || value === '' ? '—' : typeof value === 'string' ? value : JSON.stringify(value));

let readme = null;
if (entry.readme) {
  const processor = await createMarkdownProcessor();
  readme = (await processor.render(entry.readme)).code;
}

const headings = [
  { depth: 2, slug: 'about', text: 'About' },
  ...(barViews.length || hasSettings ? [{ depth: 2, slug: 'using-it', text: 'Using it' }] : []),
  ...(parts.length ? [{ depth: 2, slug: 'how-its-built', text: "How it's built" }] : []),
  ...(isPlugin ? [{ depth: 2, slug: 'permissions', text: 'Permissions' }] : []),
  { depth: 2, slug: 'install', text: 'Install' },
  ...(readme ? [{ depth: 2, slug: 'readme', text: 'More' }] : []),
];
---

<StarlightPage frontmatter={{ title: manifest.name, description: manifest.description }} headings={headings}>
  {previews.map((preview) => (
    <img class="plugin-hero" src={`${RAW}/${path}/${preview}`} alt={`${manifest.name} in the bar`} />
  ))}

  <h2 id="about">About</h2>
  {manifest.description && <p>{manifest.description}</p>}
  <table>
    <tbody>
      <tr><th>Id</th><td><code>{manifest.id}</code></td></tr>
      <tr><th>Version</th><td>{manifest.version}</td></tr>
      <tr><th>Type</th><td>{isPlugin ? 'Plugin' : `${manifest.colours?.kind ?? ''} theme`}</td></tr>
      <tr><th>Works under</th><td>{compositors.includes('any') ? 'any compositor' : compositors.join(', ')}</td></tr>
      {manifest.blxshell && <tr><th>blxshell</th><td><code>{manifest.blxshell}</code></td></tr>}
      {authors.length > 0 && (
        <tr><th>By</th><td>{authors.map((author, index) => (
          <>{index > 0 && ', '}{author.url ? <a href={author.url}>{author.name}</a> : author.name}</>
        ))}</td></tr>
      )}
      {manifest.license && <tr><th>License</th><td>{manifest.license}</td></tr>}
      <tr><th>Source</th><td><a href={`${TREE}/${path}`}>{path}</a></td></tr>
    </tbody>
  </table>

  {(barViews.length > 0 || hasSettings) && (
    <>
      <h2 id="using-it">Using it</h2>
      <p>
        Turn it on in <strong>Settings → Plugins</strong>.
        {barViews.length > 0 && <> Place {barViews.length === 1 ? 'its bar module' : 'its bar modules'} from the same page, or add the id to <code>bar.left</code>, <code>bar.center</code> or <code>bar.right</code> in <code>config.json</code>.</>}
        {hasSettings && <> Its settings are on its page there too.</>}
      </p>
      {barViews.length > 0 && (
        <table>
          <thead><tr><th>Bar module</th></tr></thead>
          <tbody>{barViews.map((view) => <tr><td><code>{manifest.id}:{view}</code></td></tr>)}</tbody>
        </table>
      )}
    </>
  )}

  {parts.length > 0 && (
    <>
      <h2 id="how-its-built">How it's built</h2>
      <table>
        <tbody>{parts.map(([part, detail]) => <tr><th>{part}</th><td><code>{detail.split(':')[0]}</code>{':' + detail.split(':').slice(1).join(':')}</td></tr>)}</tbody>
      </table>
    </>
  )}

  {isPlugin && (
    <>
      <h2 id="permissions">Permissions</h2>
      {permissions.length === 0 ? (
        <p>None: it only shows its module and reacts to clicks.</p>
      ) : (
        <ul>
          {permissions.map((permission) => (
            <li><code>{permission}</code>: {meaning[permission] ?? 'An unknown permission.'}</li>
          ))}
        </ul>
      )}
      <Aside type="note">
        A plugin runs as you, like any program you start. Permissions limit what
        it may ask blxshell to do and say what it does; they aren't a sandbox.
        Everything in the official pool is reviewed before it's merged.
      </Aside>
    </>
  )}

  <h2 id="install">Install</h2>
  <pre><code>{`blxshell install ${manifest.id}`}</code></pre>
  <p>
    {isPlugin ? (
      <>Then turn it on in <strong>Settings → Plugins</strong>, or with <code>blxshell plugin enable {manifest.id}</code>.</>
    ) : (
      <>Then apply it with <code>blxshell theme apply {manifest.id}</code>.</>
    )}
    {' '}<code>blxshell update</code> keeps it current. More in <a href="/plugins/installing/">Installing</a>.
  </p>

  {readme && (
    <>
      <h2 id="readme">More</h2>
      <Fragment set:html={readme} />
    </>
  )}
</StarlightPage>

<style>
  .plugin-hero {
    display: block;
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
    border-radius: 1rem;
    border: 1px solid var(--sl-color-gray-5);
  }
  th {
    white-space: nowrap;
  }
</style>
